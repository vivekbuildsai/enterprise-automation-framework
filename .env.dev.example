# Per-environment overrides for AUTOMATION_ENV=dev. Copy to `.env.dev` and fill in
# real values — never commit the real file. Loaded on top of the shared
# `.env` (see .env.example); anything set here wins over `.env` for this
# environment, and a real process/CI environment variable always wins over
# both files. Only the fields Phase 2 calls out as "must be configurable,
# never hardcoded" live here — everything else (API/DB config, validation
# mode, ...) stays in the shared `.env`.

AUTOMATION_UI_BASE_URL=https://the-internet.herokuapp.com
AUTOMATION_UI_USERNAME=tomsmith
AUTOMATION_UI_PASSWORD=SuperSecretPassword!

AUTOMATION_BROWSER=chromium
AUTOMATION_HEADLESS=true
AUTOMATION_ACTION_TIMEOUT_MS=15000
AUTOMATION_NAVIGATION_TIMEOUT_MS=30000

# A real customer/target application — only reachable on certain networks
# (e.g. a private/internal address), so this is left unset by default.
# Fill in with your own real values (never commit them) to point the
# `target_app` UI target (config/environments/dev.yaml) at a real app.
# AUTOMATION_APP_BASE_URL=http://<internal-host>:<port>
# AUTOMATION_APP_USERNAME=<username>
# AUTOMATION_APP_PASSWORD=<password>

# ClickHouse (framework.database.clickhouse) — the database half of the
# UI-widget-vs-database validation pipeline (see DashboardRepository).
# Leave AUTOMATION_CLICKHOUSE_ENABLED unset/false until real connection
# details are available.
# AUTOMATION_CLICKHOUSE_ENABLED=true
# AUTOMATION_CLICKHOUSE_HOST=<internal-host>
# AUTOMATION_CLICKHOUSE_PORT=8123
# AUTOMATION_CLICKHOUSE_DATABASE=<database>
# AUTOMATION_CLICKHOUSE_USER=<username>
# AUTOMATION_CLICKHOUSE_PASSWORD=<password>
# AUTOMATION_CLICKHOUSE_PROTOCOL=http

# framework.ai (optional AI-assisted recommendations for Discovery/Sync) —
# disabled by default. `provider` speaks the OpenAI chat-completions API
# shape, so this works for cloud OpenAI, Azure OpenAI, or a self-hosted/
# local server (Ollama, vLLM, LM Studio, an enterprise inference gateway).
# AUTOMATION_AI_ENABLED=true
# AUTOMATION_AI_PROVIDER=openai_compatible
# AUTOMATION_AI_ENDPOINT=https://api.openai.com/v1
# AUTOMATION_AI_MODEL=gpt-4o-mini
# AUTOMATION_AI_API_KEY=<api-key>
# AUTOMATION_AI_TIMEOUT_SECONDS=30
# AUTOMATION_AI_TEMPERATURE=0.2
