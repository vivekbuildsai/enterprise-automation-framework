# Per-environment overrides for AUTOMATION_ENV=preprod. Copy to `.env.preprod` and
# fill in real values — never commit the real file. See .env.dev.example for
# how this layers with the shared `.env`.

AUTOMATION_UI_BASE_URL=https://preprod.example.com
AUTOMATION_UI_USERNAME=
AUTOMATION_UI_PASSWORD=

AUTOMATION_BROWSER=chromium
AUTOMATION_HEADLESS=true
AUTOMATION_ACTION_TIMEOUT_MS=20000
AUTOMATION_NAVIGATION_TIMEOUT_MS=45000
