# Copy to .env and fill in real values. Never commit the real .env file.
#
# This file holds defaults shared across every environment. For values that
# differ per environment (BASE_URL, USERNAME, PASSWORD, TIMEOUTS, HEADLESS,
# BROWSER), also copy .env.{dev,qa,uat,preprod,production}.example to
# .env.{environment} — see .env.dev.example. Precedence (highest first):
# real process/CI environment variables > .env.{environment} > this file.

AUTOMATION_ENV=dev

AUTOMATION_UI_BASE_URL=https://the-internet.herokuapp.com
AUTOMATION_UI_USERNAME=tomsmith
AUTOMATION_UI_PASSWORD=SuperSecretPassword!

AUTOMATION_API_SUBSCRIBER_URL=https://api.dev.example.com/subscriber
AUTOMATION_API_CLIENT_ID=
AUTOMATION_API_CLIENT_SECRET=
AUTOMATION_API_DUMMYJSON_URL=https://dummyjson.com

# ui_only | ui_api | ui_database | ui_api_database — controls which layers
# ValidationFacade actually runs; test code never changes when this does.
AUTOMATION_VALIDATION_MODE=ui_api_database

# postgresql | mysql | oracle | mssql | sqlite — sqlite (in-memory, no
# server needed) is the zero-setup local default. To point this at a real
# server instead, set AUTOMATION_DB_DIALECT/HOST/PORT/NAME/USER/PASSWORD — see
# docs/DatabaseConfiguration.md for a worked example per dialect.
AUTOMATION_DB_DIALECT=sqlite
AUTOMATION_DB_HOST=
AUTOMATION_DB_PORT=0
AUTOMATION_DB_NAME=:memory:
AUTOMATION_DB_USER=
AUTOMATION_DB_PASSWORD=
# Only needed if a config uses `encrypted_password` instead of `password`
# (see framework.database.utilities.secrets.CredentialResolver).
AUTOMATION_DB_SECRET_KEY=
