# Per-environment overrides for AUTOMATION_ENV=production. Copy to
# `.env.production` and fill in real values — never commit the real file.
# See .env.dev.example for how this layers with the shared `.env`.
#
# PRODUCTION is read-only smoke/sanity territory (see
# config/environments/production.yaml) — headless is intentionally not
# overridden lower than the default and timeouts stay generous.

AUTOMATION_UI_BASE_URL=https://www.example.com
AUTOMATION_UI_USERNAME=
AUTOMATION_UI_PASSWORD=

AUTOMATION_BROWSER=chromium
AUTOMATION_HEADLESS=true
AUTOMATION_ACTION_TIMEOUT_MS=20000
AUTOMATION_NAVIGATION_TIMEOUT_MS=45000
